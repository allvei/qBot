[Unit]
Description=qBot PUG bot (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Instance name is the service user: systemctl enable --now qbot@<user>
# The bot is expected in ~/qbot of that user (binary at target/release/qbot, .env and qbot.db alongside)
User=%i
WorkingDirectory=~
ExecStart=/bin/sh -c 'cd "$HOME/qbot" && exec ./target/release/qbot -nogui'
# Exit 0 (qbot ctl stop, systemctl stop) stays down; exit 75 (qbot ctl restart) comes back up
Restart=on-failure
RestartForceExitStatus=75
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
