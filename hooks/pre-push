#!/bin/bash

# Pre-push hook to enforce changelog updates and version bumps
# This hook prevents pushing if:
# 1. CHANGELOG.md hasn't been modified in commits being pushed
# 2. Cargo.toml version hasn't been bumped in commits being pushed

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Get the remote name and URL
remote="$1"
url="$2"

# Read stdin to get the range of commits being pushed
while read local_ref local_sha remote_ref remote_sha
do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Branch is being deleted, allow it
        continue
    fi

    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New branch, check all commits
        range="$local_sha"
    else
        # Existing branch, check commits between remote and local
        range="$remote_sha..$local_sha"
    fi

    # Check if there are any commits to push
    commits=$(git rev-list "$range" 2>/dev/null)
    if [ -z "$commits" ]; then
        continue
    fi

    # Check if CHANGELOG.md was modified in any of the commits being pushed
    changelog_modified=$(git diff --name-only "$range" | grep -c "^CHANGELOG.md$")
    
    # Check if Cargo.toml was modified in any of the commits being pushed
    cargo_modified=$(git diff --name-only "$range" | grep -c "^Cargo.toml$")
    
    # Get current version from Cargo.toml
    current_version=$(grep '^version' Cargo.toml | head -1 | sed 's/version.*=.*"\(.*\)"/\1/')
    
    # Get previous version from remote
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
        previous_version=$(git show "$remote_sha:Cargo.toml" 2>/dev/null | grep '^version' | head -1 | sed 's/version.*=.*"\(.*\)"/\1/')
    else
        # New branch, no previous version to compare
        previous_version=""
    fi

    # Flag to track if push should be blocked
    should_block=0

    echo ""
    echo -e "${YELLOW}=== Pre-push validation ===${NC}"
    echo ""

    # Check CHANGELOG.md
    if [ "$changelog_modified" -eq 0 ]; then
        echo -e "${RED}✗ CHANGELOG.md has not been updated${NC}"
        echo "  Please update CHANGELOG.md with your changes"
        should_block=1
    else
        echo -e "${GREEN}✓ CHANGELOG.md has been updated${NC}"
    fi

    # Check version bump
    if [ "$cargo_modified" -eq 0 ]; then
        echo -e "${RED}✗ Cargo.toml version has not been changed${NC}"
        echo "  Current version: $current_version"
        echo "  Please bump the version in Cargo.toml"
        should_block=1
    else
        if [ -n "$previous_version" ]; then
            if [ "$current_version" = "$previous_version" ]; then
                echo -e "${RED}✗ Version has not been bumped${NC}"
                echo "  Current version: $current_version"
                echo "  Previous version: $previous_version"
                echo "  Please increment the version in Cargo.toml"
                should_block=1
            else
                echo -e "${GREEN}✓ Version bumped: $previous_version → $current_version${NC}"
            fi
        else
            echo -e "${GREEN}✓ Cargo.toml version set to: $current_version${NC}"
        fi
    fi

    echo ""

    # Block push if validation failed
    if [ "$should_block" -eq 1 ]; then
        echo -e "${RED}Push rejected!${NC}"
        echo ""
        echo "To fix this:"
        echo "  1. Update CHANGELOG.md with your changes"
        echo "  2. Bump the version in Cargo.toml (current: $current_version)"
        echo "  3. Commit the changes: git add CHANGELOG.md Cargo.toml && git commit -m 'chore: bump version and update changelog'"
        echo "  4. Try pushing again"
        echo ""
        echo "To bypass this check (not recommended): git push --no-verify"
        echo ""
        exit 1
    fi

    echo -e "${GREEN}All checks passed! Proceeding with push...${NC}"
    echo ""
done

exit 0
